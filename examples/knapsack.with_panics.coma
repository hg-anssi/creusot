module M_m
  use creusot.int.UInt64
  use seq.Seq
  use int.MinMax
  use int.Int
  
  type t_Name
  
  type t_Item_Name = { name: t_Name; weight: UInt64.t; value: UInt64.t }
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) = self >= 0 /\ self > other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant items : Seq.seq t_Item_Name
  
  constant i : int
  
  constant w : int
  
  function m_Name (items: Seq.seq t_Item_Name) (i: int) (w: int) : int
  
  goal vc_m_Name: 0 <= i /\ i <= Seq.length items
    -> 0 <= w
    -> (if i = 0 then
      [@stop_split] [@expl:m ensures] 0 >= 0
    else
      if UInt64.t'int (Seq.get items (i - 1)).weight > w then
        (([@stop_split] [@expl:m requires] ([@stop_split] [@expl:m requires #0] 0 <= i - 1 /\ i - 1 <= Seq.length items)
            /\ ([@stop_split] [@expl:m requires #1] 0 <= w))
          /\ ([@expl:variant decreases] well_founded_relation_Int i (i - 1)))
        /\ (([@stop_split] [@expl:m ensures] m_Name items (i - 1) w >= 0)
        -> ([@stop_split] [@expl:m ensures] m_Name items (i - 1) w >= 0))
      else
        (([@stop_split] [@expl:m requires] ([@stop_split] [@expl:m requires #0] 0 <= i - 1 /\ i - 1 <= Seq.length items)
            /\ ([@stop_split] [@expl:m requires #1] 0 <= w))
          /\ ([@expl:variant decreases] well_founded_relation_Int i (i - 1)))
        /\ (([@stop_split] [@expl:m ensures] m_Name items (i - 1) w >= 0)
        -> (([@stop_split] [@expl:m requires] ([@stop_split] [@expl:m requires #0] 0 <= i - 1
              /\ i - 1 <= Seq.length items)
            /\ ([@stop_split] [@expl:m requires #1] 0 <= w - UInt64.t'int (Seq.get items (i - 1)).weight))
          /\ ([@expl:variant decreases] well_founded_relation_Int i (i - 1)))
        /\ (([@stop_split] [@expl:m ensures] m_Name items (i - 1) (w - UInt64.t'int (Seq.get items (i - 1)).weight)
          >= 0)
        -> ([@stop_split] [@expl:m ensures] MinMax.max (m_Name items (i - 1) w) (m_Name items (i - 1) (w
            - UInt64.t'int (Seq.get items (i - 1)).weight)
          + UInt64.t'int (Seq.get items (i - 1)).value)
        >= 0)))
    
    )
end
