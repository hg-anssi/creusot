    [ & _ret: UInt64.t = Any.any_l () | & a: UInt64.t = a | & b: UInt64.t = b | & _7: bool = Any.any_l () ])
    [ return (result: UInt64.t) -> {[@stop_split] [@expl:max ensures] UInt64.t'int result
