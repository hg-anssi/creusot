  predicate resolve_refmut_RangeInclusive_usize [@inline:trivial] (_1: MutBorrow.t t_RangeInclusive_usize) =
    _1.final = _1.current
  
  meta "rewrite_def" predicate resolve_refmut_RangeInclusive_usize
  
  function index_Vec_u8_Global [@inline:trivial] (self: t_Vec_u8_Global) (ix: int) : UInt8.t =
