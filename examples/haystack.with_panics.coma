    {[@stop_split] [@expl:into_iter_RangeInclusive_usize ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_RangeInclusive_usize result)
      /\ ([@stop_split] [@expl:into_iter ensures] result = self_)}
