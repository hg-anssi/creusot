  type t_Option_usize = None | Some UInt64.t
  
  predicate invariant_refmut_RangeInclusive_usize [@inline:trivial] (self: MutBorrow.t t_RangeInclusive_usize) =
    inv_RangeInclusive_usize self.current /\ inv_RangeInclusive_usize self.final
  
  meta "rewrite_def" predicate invariant_refmut_RangeInclusive_usize
  
  predicate inv_refmut_RangeInclusive_usize [@inline:trivial] (_1: MutBorrow.t t_RangeInclusive_usize) =
