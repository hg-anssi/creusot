module M_apply_propagate
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  type t_F
  
  predicate inv_F (_1: t_F)
  
  predicate resolve_F (_1: t_F)
  
  predicate invariant_ref_F [@inline:trivial] (self: t_F) = inv_F self
  
  meta "rewrite_def" predicate invariant_ref_F
  
  predicate inv_ref_F [@inline:trivial] (_1: t_F) = invariant_ref_F _1
  
  meta "rewrite_def" predicate inv_ref_F
  
  predicate precondition_F (self: t_F) (args: UInt32.t)
  
  predicate postcondition_once_F (self: t_F) (args: UInt32.t) (result: UInt32.t)
  
  predicate postcondition_mut_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: UInt32.t)
  
  function fn_mut_once_F (self: t_F) (args: UInt32.t) (res: UInt32.t) : ()
  
  axiom fn_mut_once_F_spec:
    forall self: t_F, args: UInt32.t, res: UInt32.t [postcondition_once_F self args res]. postcondition_once_F self args res
      = (exists res_state: t_F. postcondition_mut_F self args res_state res /\ resolve_F res_state)
  
  predicate hist_inv_F (self: t_F) (result_state: t_F)
  
  function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()
  
  axiom hist_inv_trans_F_spec:
    forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
      -> hist_inv_F b c -> hist_inv_F self c
  
  function hist_inv_refl_F (self: t_F) : ()
  
  axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self
  
  function postcondition_mut_hist_inv_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: UInt32.t) : ()
  
  axiom postcondition_mut_hist_inv_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: UInt32.t [postcondition_mut_F self args res_state res | hist_inv_F self res_state]. postcondition_mut_F self args res_state res
      -> hist_inv_F self res_state
  
  function fn_hist_inv_F (self: t_F) (res_state: t_F) : ()
  
  axiom fn_hist_inv_F_spec: forall self: t_F, res_state: t_F [hist_inv_F self res_state]. hist_inv_F self res_state
      = (self = res_state)
  
  predicate postcondition_F (self: t_F) (args: UInt32.t) (result: UInt32.t)
  
  function fn_once_F (self: t_F) (args: UInt32.t) (res: UInt32.t) : ()
  
  axiom fn_once_F_spec:
    forall self: t_F, args: UInt32.t, res: UInt32.t [postcondition_once_F self args res]. postcondition_once_F self args res
      = (postcondition_F self args res /\ resolve_F self)
  
  function fn_mut_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: UInt32.t) : ()
  
  axiom fn_mut_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: UInt32.t [postcondition_mut_F self args res_state res]. postcondition_mut_F self args res_state res
      = (postcondition_F self args res /\ self = res_state)
  
  predicate panic_condition_F (self: t_F) (args: UInt32.t)
  
  let call_F (self_: t_F) (arg: UInt32.t) (panic) (return (x: UInt32.t)) =
  {[@stop_split] [@expl:call_F requires] ([@stop_split] [@expl:call 'self_' type invariant] inv_ref_F self_)
    /\ ([@stop_split] [@expl:call requires] precondition_F self_ arg)}
    any
    [ return (result: UInt32.t) -> {[@stop_split] [@expl:call ensures] postcondition_F self_ arg result}
      (! return {result})
    | panic -> {[@stop_split] [@expl:call may_panic] panic_condition_F self_ arg} (! panic) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let apply_propagate_F (f: t_F) (x: UInt32.t) (panic) (return (x'0: UInt32.t)) =
  {[@stop_split] [@expl:apply_propagate_F requires] ([@stop_split] [@expl:apply_propagate 'f' type invariant] inv_F f)
    /\ ([@stop_split] [@expl:apply_propagate requires] precondition_F f x)}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_F f} any) ]
      | s1 = -{resolve_F f}- s2
      | s2 = [ &_16 <- x ] s3
      | s3 = call_F {f} {_16} (panic) (fun (_x: UInt32.t) -> [ &_ret <- _x ] s4)
      | s4 = return {_ret} ] ]
    [ & _ret: UInt32.t = Any.any_l () | & f: t_F = f | & x: UInt32.t = x | & _16: UInt32.t = Any.any_l () ])
    [ return (result: UInt32.t) ->
    {[@stop_split] [@expl:apply_propagate_F ensures] ([@stop_split] [@expl:apply_propagate ensures #0] not panic_condition_F f x)
      /\ ([@stop_split] [@expl:apply_propagate ensures #1] postcondition_F f x result)}
      (! return {result})
    | panic -> {[@stop_split] [@expl:apply_propagate may_panic] panic_condition_F f x} (! panic) ]
end
module M_fake_panic
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let fake_panic (n: UInt32.t) (panic) (return (x: UInt32.t)) = (! bb0
    [ bb0 = s0 [ s0 = [ &_ret <- n ] s1 | s1 = return {_ret} ] ]
    [ & _ret: UInt32.t = Any.any_l () | & n: UInt32.t = n ])
    [ return (result: UInt32.t) -> (! return {result}) | panic -> (! panic) ]
end
module M_testlk
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  predicate precondition_fake_panic (self: ()) (args: UInt32.t) = let n = args in true
  
  meta "rewrite_def" predicate precondition_fake_panic
  
  predicate panic_condition_fake_panic (self: ()) (args: UInt32.t) = let n = args in true
  
  meta "rewrite_def" predicate panic_condition_fake_panic
  
  predicate postcondition_once_fake_panic (self: ()) (args: UInt32.t) (result: UInt32.t) = let n = args in true
  
  meta "rewrite_def" predicate postcondition_once_fake_panic
  
  predicate resolve_fake_panic [@inline:trivial] (_1: ()) = true
  
  meta "rewrite_def" predicate resolve_fake_panic
  
  predicate postcondition_mut_fake_panic (self: ()) (args: UInt32.t) (result_state: ()) (result: UInt32.t) =
    let n = args in true
  
  meta "rewrite_def" predicate postcondition_mut_fake_panic
  
  function fn_mut_once_fake_panic (self: ()) (args: UInt32.t) (res: UInt32.t) : ()
  
  axiom fn_mut_once_fake_panic_spec:
    forall self: (), args: UInt32.t, res: UInt32.t [postcondition_once_fake_panic self args res]. postcondition_once_fake_panic self args res
      = (exists res_state: (). postcondition_mut_fake_panic self args res_state res /\ resolve_fake_panic res_state)
  
  predicate hist_inv_fake_panic (self: ()) (result_state: ()) = true
  
  function hist_inv_trans_fake_panic (self: ()) (b: ()) (c: ()) : ()
  
  axiom hist_inv_trans_fake_panic_spec:
    forall self: (), b: (), c: () [hist_inv_fake_panic self b, hist_inv_fake_panic b c | hist_inv_fake_panic self b, hist_inv_fake_panic self c | hist_inv_fake_panic b c, hist_inv_fake_panic self c]. hist_inv_fake_panic self b
      -> hist_inv_fake_panic b c -> hist_inv_fake_panic self c
  
  function hist_inv_refl_fake_panic (self: ()) : ()
  
  axiom hist_inv_refl_fake_panic_spec: forall self: () [hist_inv_fake_panic self self]. hist_inv_fake_panic self self
  
  function postcondition_mut_hist_inv_fake_panic (self: ()) (args: UInt32.t) (res_state: ()) (res: UInt32.t) : ()
  
  axiom postcondition_mut_hist_inv_fake_panic_spec:
    forall self: (), args: UInt32.t, res_state: (), res: UInt32.t [postcondition_mut_fake_panic self args res_state res | hist_inv_fake_panic self res_state]. postcondition_mut_fake_panic self args res_state res
      -> hist_inv_fake_panic self res_state
  
  function fn_hist_inv_fake_panic (self: ()) (res_state: ()) : ()
  
  axiom fn_hist_inv_fake_panic_spec:
    forall self: (), res_state: () [hist_inv_fake_panic self res_state]. hist_inv_fake_panic self res_state
      = (self = res_state)
  
  predicate postcondition_fake_panic (self: ()) (args: UInt32.t) (result: UInt32.t) = let n = args in true
  
  meta "rewrite_def" predicate postcondition_fake_panic
  
  function fn_once_fake_panic (self: ()) (args: UInt32.t) (res: UInt32.t) : ()
  
  axiom fn_once_fake_panic_spec:
    forall self: (), args: UInt32.t, res: UInt32.t [postcondition_once_fake_panic self args res]. postcondition_once_fake_panic self args res
      = (postcondition_fake_panic self args res /\ resolve_fake_panic self)
  
  function fn_mut_fake_panic (self: ()) (args: UInt32.t) (res_state: ()) (res: UInt32.t) : ()
  
  axiom fn_mut_fake_panic_spec:
    forall self: (), args: UInt32.t, res_state: (), res: UInt32.t [postcondition_mut_fake_panic self args res_state res]. postcondition_mut_fake_panic self args res_state res
      = (postcondition_fake_panic self args res /\ self = res_state)
  
  let apply_propagate_fake_panic (f: ()) (x: UInt32.t) (panic) (return (x'0: UInt32.t)) =
  {[@stop_split] [@expl:apply_propagate requires] precondition_fake_panic f x}
    any
    [ return (result: UInt32.t) ->
    {[@stop_split] [@expl:apply_propagate_fake_panic ensures] ([@stop_split] [@expl:apply_propagate ensures #0] not panic_condition_fake_panic f x)
      /\ ([@stop_split] [@expl:apply_propagate ensures #1] postcondition_fake_panic f x result)}
      (! return {result})
    | panic -> {[@stop_split] [@expl:apply_propagate may_panic] panic_condition_fake_panic f x} (! panic) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let testlk (panic) (return (x: UInt32.t)) = (! bb0
    [ bb0 = s0
      [ s0 = apply_propagate_fake_panic {()} {(5: UInt32.t)} (panic) (fun (_x: UInt32.t) -> [ &_ret <- _x ] s1)
      | s1 = return {_ret} ] ] [ & _ret: UInt32.t = Any.any_l () ])
    [ return (result: UInt32.t) -> {[@stop_split] [@expl:testlk ensures] not true} (! return {result})
    | panic -> (! panic) ]
end
