module M_may_panic
  use creusot.prelude.Any
  use creusot.int.UInt8
  
  type t_Arguments
  
  predicate inv_Arguments (_1: t_Arguments)
  
  let from_str (s: string) (return (x: t_Arguments)) = any
    [ return (result: t_Arguments) -> {[@stop_split] [@expl:from_str result type invariant] inv_Arguments result}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let may_panic (return (x: UInt8.t)) = (! bb0
    [ bb0 = s0 [ s0 = from_str {"boom"} (fun (_x: t_Arguments) -> [ &_4 <- _x ] s1) | s1 = {false} any ] ]
    [ & _4: t_Arguments = Any.any_l () ]) [ return (result: UInt8.t) -> (! return {result}) ]
end
