  meta "rewrite_def" predicate invariant_ref_F
  
  predicate inv_ref_F [@inline:trivial] (_1: t_F) = invariant_ref_F _1
  
  meta "rewrite_def" predicate inv_ref_F
  
  predicate precondition_F (self: t_F) (args: UInt32.t)
  
  predicate postcondition_once_F (self: t_F) (args: UInt32.t) (result: UInt32.t)
  
  predicate postcondition_mut_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: UInt32.t)
  
  function fn_mut_once_F (self: t_F) (args: UInt32.t) (res: UInt32.t) : ()
  
