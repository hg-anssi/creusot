module M_generic_ghost_no_panic
  use creusot.int.Int32
  use creusot.prelude.Any
  
  type t_F
  
  predicate inv_F (_1: t_F)
  
  predicate resolve_F (_1: t_F)
  
  predicate panic_condition_F (self: t_F) (args: Int32.t) = false
  
  meta "rewrite_def" predicate panic_condition_F
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let generic_ghost_no_panic_F (f: t_F) (return (x: ())) =
  {[@stop_split] [@expl:generic_ghost_no_panic 'f' type invariant] inv_F f}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_F f} any) ]
      | s1 = -{resolve_F f}- s2
      | s2 = {[@expl:assertion] forall n: Int32.t. not panic_condition_F f n} s3
      | s3 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & f: t_F = f ])
    [ return (result: ()) -> (! return {result}) ]
end
