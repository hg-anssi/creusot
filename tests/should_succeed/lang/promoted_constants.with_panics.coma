module M_str
  use creusot.prelude.Any
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let str (return (x: string)) = (! bb0
    [ bb0 = s0
      [ s0 =
        [ &_s <- "1234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890" ]
        s1
      | s1 = [ &_ret <- _s ] s2
      | s2 = return {_ret} ] ] [ & _ret: string = Any.any_l () | & _s: string = Any.any_l () ])
    [ return (result: string) -> (! return {result}) ]
end
module M_string
  use creusot.prelude.Any
  
  type t_String
  
  predicate inv_String (_1: t_String)
  
  predicate resolve_String (_1: t_String)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let string' (_s: t_String) (return (x: ())) = {[@stop_split] [@expl:string '_s' type invariant] inv_String _s}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_String _s} any) ]
      | s1 = -{resolve_String _s}- s2
      | s2 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & _s: t_String = _s ])
    [ return (result: ()) -> (! return {result}) ]
end
