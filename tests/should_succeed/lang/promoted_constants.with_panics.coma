      | s1 = bb0'0
        [ bb0'0 = s0'0
          [ s0'0 = [ &_1 <- Some (42: Int32.t) ] s1'0 | s1'0 = [ &_ret'0 <- _1 ] s2'0 | s2'0 = _const_ret {_ret'0} ] ]
        [ & _ret'0: t_Option_i32 = Any.any_l () | & _1: t_Option_i32 = Any.any_l () ]
        [ _const_ret (_const: t_Option_i32) -> [ &_12 <- _const ] s2 ]
      | s2 = bb0'0
        [ bb0'0 = s0'0
