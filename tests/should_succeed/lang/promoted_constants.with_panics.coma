        [ & _ret'0: t_Option_i32 = Any.any_l () | & _1: t_Option_i32 = Any.any_l () ]
        [ _const_ret (_const: t_Option_i32) -> [ &_11 <- _const ] s3 ]
      | s3 = [ &_3 <- { f0 = _12; f1 = _11 } ] s4
      | s4 = any [ br0 -> {_3.f0 = None} (! bb2) | br1 (x0: Int32.t) -> {_3.f0 = Some x0} (! bb1) ] ]
    | bb2 = any [ br0 -> {_3.f1 = None} (! bb4) | br1 (x0: Int32.t) -> {_3.f1 = Some x0} (! bb1) ]
    | bb1 = s0 [ s0 = [ &_ret <- _ix ] s1 | s1 = return {_ret} ]
    | bb4 = {false} any ]
    [ & _ret: t_Option_i32 = Any.any_l ()
    | & _ix: t_Option_i32 = Any.any_l ()
    | & _3: tup2_ref_Option_i32_ref_Option_i32 = Any.any_l ()
    | & _11: t_Option_i32 = Any.any_l ()
    | & _12: t_Option_i32 = Any.any_l () ]) [ return (result: t_Option_i32) -> (! return {result}) ]
