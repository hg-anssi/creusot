module M_promoted_int
  use creusot.int.Int32
  use creusot.prelude.Any
  
  type tup2_i32_bool = { f0: Int32.t; f1: bool }
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let promoted_int (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = [ &_4 <- let (_fst, _snd) = Int32.add_with_overflow (1: Int32.t) (5: Int32.t) in { f0 = _fst; f1 = _snd } ]
        s1
      | s1 = {[@expl:Add overflow] not _4.f1} s2
      | s2 = [ &_5 <- let (_fst, _snd) = Int32.add_with_overflow _4.f0 (10: Int32.t) in { f0 = _fst; f1 = _snd } ] s3
      | s3 = {[@expl:Add overflow] not _5.f1} s4
      | s4 = bb0'0
        [ bb0'0 = s0'0
          [ s0'0 = [ &_4'0 <- let (_fst, _snd) = Int32.add_with_overflow (1: Int32.t) (5: Int32.t) in { f0 = _fst;
                                                                                                        f1 = _snd } ]
            s1'0
          | s1'0 = [ &_2 <- let (_fst, _snd) = Int32.add_with_overflow _4'0.f0 (10: Int32.t) in { f0 = _fst;
                                                                                                  f1 = _snd } ] s2'0
          | s2'0 = [ &_ret'0 <- _2.f0 ] s3'0
          | s3'0 = _const_ret {_ret'0} ] ]
        [ & _ret'0: Int32.t = Any.any_l () | & _2: tup2_i32_bool = Any.any_l () | & _4'0: tup2_i32_bool = Any.any_l () ]
        [ _const_ret (_const: Int32.t) -> [ &_10 <- _const ] s5 ]
      | s5 = [ &ix <- _10 ] s6
      | s6 = [ &_6 <- ix <> (16: Int32.t) ] s7
      | s7 = any [ br0 -> {_6 = false} (! bb4) | br1 -> {_6} (! bb3) ] ]
    | bb3 = {false} any
    | bb4 = return {_ret} ]
    [ & _ret: () = Any.any_l ()
    | & ix: Int32.t = Any.any_l ()
    | & _4: tup2_i32_bool = Any.any_l ()
    | & _5: tup2_i32_bool = Any.any_l ()
    | & _6: bool = Any.any_l ()
    | & _10: Int32.t = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
module M_promoted_none
