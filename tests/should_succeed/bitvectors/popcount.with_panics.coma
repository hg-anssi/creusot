module M_count16
  use creusot.int.Int32BW
  use creusot.int.UInt32BW
  use creusot.int.UInt16BW
  use creusot.prelude.Any
  use int.Int
  
  type tup2_u16_bool = { f0: UInt16BW.t; f1: bool }
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let count16 (n: UInt16BW.t) (return (x: UInt16BW.t)) = (! bb0
    [ bb0 = s0
      [ s0 = [ &x <- n ] s1
      | s1 = [ &_8 <- (1: Int32BW.t) ] s2
      | s2 = [ &_9 <- UInt32BW.lt _8 (16: UInt32BW.t) ] s3
      | s3 = {[@expl:Shr overflow] _9} s4
      | s4 = UInt16BW.shr {x} {Int32BW.to_BV256 (1: Int32BW.t)} (fun (_x: UInt16BW.t) -> [ &_6 <- _x ] s5)
      | s5 = [ &_5 <- UInt16BW.bw_and _6 (21845: UInt16BW.t) ] s6
      | s6 = [ &_10 <- let (_fst, _snd) = UInt16BW.sub_with_overflow x _5 in { f0 = _fst; f1 = _snd } ] s7
      | s7 = {[@expl:Sub overflow] not _10.f1} s8
      | s8 = [ &x <- _10.f0 ] s9
      | s9 = [ &_11 <- UInt16BW.bw_and x (13107: UInt16BW.t) ] s10
      | s10 = [ &_16 <- (2: Int32BW.t) ] s11
      | s11 = [ &_17 <- UInt32BW.lt _16 (16: UInt32BW.t) ] s12
      | s12 = {[@expl:Shr overflow] _17} s13
      | s13 = UInt16BW.shr {x} {Int32BW.to_BV256 (2: Int32BW.t)} (fun (_x: UInt16BW.t) -> [ &_14 <- _x ] s14)
      | s14 = [ &_13 <- UInt16BW.bw_and _14 (13107: UInt16BW.t) ] s15
      | s15 = [ &_18 <- let (_fst, _snd) = UInt16BW.add_with_overflow _11 _13 in { f0 = _fst; f1 = _snd } ] s16
      | s16 = {[@expl:Add overflow] not _18.f1} s17
      | s17 = [ &x <- _18.f0 ] s18
      | s18 = [ &_23 <- (4: Int32BW.t) ] s19
      | s19 = [ &_24 <- UInt32BW.lt _23 (16: UInt32BW.t) ] s20
      | s20 = {[@expl:Shr overflow] _24} s21
      | s21 = UInt16BW.shr {x} {Int32BW.to_BV256 (4: Int32BW.t)} (fun (_x: UInt16BW.t) -> [ &_21 <- _x ] s22)
      | s22 = [ &_25 <- let (_fst, _snd) = UInt16BW.add_with_overflow x _21 in { f0 = _fst; f1 = _snd } ] s23
      | s23 = {[@expl:Add overflow] not _25.f1} s24
      | s24 = [ &x <- UInt16BW.bw_and _25.f0 (3855: UInt16BW.t) ] s25
      | s25 = [ &_29 <- (8: Int32BW.t) ] s26
      | s26 = [ &_30 <- UInt32BW.lt _29 (16: UInt32BW.t) ] s27
      | s27 = {[@expl:Shr overflow] _30} s28
      | s28 = UInt16BW.shr {x} {Int32BW.to_BV256 (8: Int32BW.t)} (fun (_x: UInt16BW.t) -> [ &_27 <- _x ] s29)
      | s29 = [ &_31 <- let (_fst, _snd) = UInt16BW.add_with_overflow x _27 in { f0 = _fst; f1 = _snd } ] s30
      | s30 = {[@expl:Add overflow] not _31.f1} s31
      | s31 = [ &x <- _31.f0 ] s32
      | s32 = [ &_ret <- UInt16BW.bw_and x (31: UInt16BW.t) ] s33
      | s33 = return {_ret} ] ]
    [ & _ret: UInt16BW.t = Any.any_l ()
    | & n: UInt16BW.t = n
    | & x: UInt16BW.t = Any.any_l ()
    | & _5: UInt16BW.t = Any.any_l ()
    | & _6: UInt16BW.t = Any.any_l ()
    | & _8: UInt32BW.t = Any.any_l ()
    | & _9: bool = Any.any_l ()
    | & _10: tup2_u16_bool = Any.any_l ()
    | & _11: UInt16BW.t = Any.any_l ()
    | & _13: UInt16BW.t = Any.any_l ()
    | & _14: UInt16BW.t = Any.any_l ()
    | & _16: UInt32BW.t = Any.any_l ()
    | & _17: bool = Any.any_l ()
    | & _18: tup2_u16_bool = Any.any_l ()
    | & _21: UInt16BW.t = Any.any_l ()
    | & _23: UInt32BW.t = Any.any_l ()
    | & _24: bool = Any.any_l ()
    | & _25: tup2_u16_bool = Any.any_l ()
    | & _27: UInt16BW.t = Any.any_l ()
    | & _29: UInt32BW.t = Any.any_l ()
    | & _30: bool = Any.any_l ()
    | & _31: tup2_u16_bool = Any.any_l () ])
    [ return (result: UInt16BW.t) -> {[@stop_split] [@expl:count16 ensures] UInt16BW.t'int result <= 16}
      (! return {result}) ]
end
