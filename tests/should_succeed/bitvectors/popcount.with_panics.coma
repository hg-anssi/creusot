module M_count8
  use creusot.int.Int32BW
  use creusot.int.UInt32BW
  use creusot.int.UInt8BW
  use creusot.prelude.Any
  use int.Int
  
  type tup2_u8_bool = { f0: UInt8BW.t; f1: bool }
  
  function count8_log (n: UInt8BW.t) : int = (if UInt8BW.bw_and n (1: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
                + (if UInt8BW.bw_and n (2: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
              + (if UInt8BW.bw_and n (4: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
            + (if UInt8BW.bw_and n (8: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
          + (if UInt8BW.bw_and n (16: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
        + (if UInt8BW.bw_and n (32: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
      + (if UInt8BW.bw_and n (64: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
    + (if UInt8BW.bw_and n (128: UInt8BW.t) = (0: UInt8BW.t) then 0 else 1)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let count8 (n: UInt8BW.t) (return (x: UInt8BW.t)) = (! bb0
    [ bb0 = s0
      [ s0 = [ &x <- n ] s1
      | s1 = [ &_10 <- (1: Int32BW.t) ] s2
      | s2 = [ &_11 <- UInt32BW.lt _10 (8: UInt32BW.t) ] s3
      | s3 = {[@expl:Shr overflow] _11} s4
      | s4 = UInt8BW.shr {x} {Int32BW.to_BV256 (1: Int32BW.t)} (fun (_x: UInt8BW.t) -> [ &_8 <- _x ] s5)
      | s5 = [ &_7 <- UInt8BW.bw_and _8 (85: UInt8BW.t) ] s6
      | s6 = [ &_12 <- let (_fst, _snd) = UInt8BW.sub_with_overflow x _7 in { f0 = _fst; f1 = _snd } ] s7
      | s7 = {[@expl:Sub overflow] not _12.f1} s8
      | s8 = [ &x <- _12.f0 ] s9
      | s9 = [ &_13 <- UInt8BW.bw_and x (51: UInt8BW.t) ] s10
      | s10 = [ &_18 <- (2: Int32BW.t) ] s11
      | s11 = [ &_19 <- UInt32BW.lt _18 (8: UInt32BW.t) ] s12
      | s12 = {[@expl:Shr overflow] _19} s13
      | s13 = UInt8BW.shr {x} {Int32BW.to_BV256 (2: Int32BW.t)} (fun (_x: UInt8BW.t) -> [ &_16 <- _x ] s14)
      | s14 = [ &_15 <- UInt8BW.bw_and _16 (51: UInt8BW.t) ] s15
      | s15 = [ &_20 <- let (_fst, _snd) = UInt8BW.add_with_overflow _13 _15 in { f0 = _fst; f1 = _snd } ] s16
      | s16 = {[@expl:Add overflow] not _20.f1} s17
      | s17 = [ &x <- _20.f0 ] s18
      | s18 = [ &_25 <- (4: Int32BW.t) ] s19
      | s19 = [ &_26 <- UInt32BW.lt _25 (8: UInt32BW.t) ] s20
      | s20 = {[@expl:Shr overflow] _26} s21
      | s21 = UInt8BW.shr {x} {Int32BW.to_BV256 (4: Int32BW.t)} (fun (_x: UInt8BW.t) -> [ &_23 <- _x ] s22)
      | s22 = [ &_27 <- let (_fst, _snd) = UInt8BW.add_with_overflow x _23 in { f0 = _fst; f1 = _snd } ] s23
      | s23 = {[@expl:Add overflow] not _27.f1} s24
      | s24 = [ &x <- UInt8BW.bw_and _27.f0 (15: UInt8BW.t) ] s25
      | s25 = [ &_ret <- x ] s26
      | s26 = return {_ret} ] ]
    [ & _ret: UInt8BW.t = Any.any_l ()
    | & n: UInt8BW.t = n
    | & x: UInt8BW.t = Any.any_l ()
    | & _7: UInt8BW.t = Any.any_l ()
    | & _8: UInt8BW.t = Any.any_l ()
    | & _10: UInt32BW.t = Any.any_l ()
    | & _11: bool = Any.any_l ()
    | & _12: tup2_u8_bool = Any.any_l ()
    | & _13: UInt8BW.t = Any.any_l ()
    | & _15: UInt8BW.t = Any.any_l ()
    | & _16: UInt8BW.t = Any.any_l ()
    | & _18: UInt32BW.t = Any.any_l ()
    | & _19: bool = Any.any_l ()
    | & _20: tup2_u8_bool = Any.any_l ()
    | & _23: UInt8BW.t = Any.any_l ()
    | & _25: UInt32BW.t = Any.any_l ()
    | & _26: bool = Any.any_l ()
    | & _27: tup2_u8_bool = Any.any_l () ])
    [ return (result: UInt8BW.t) ->
    {[@stop_split] [@expl:count8 ensures] ([@stop_split] [@expl:count8 ensures #0] UInt8BW.t'int result <= 8)
      /\ ([@stop_split] [@expl:count8 ensures #1] UInt8BW.t'int result = count8_log n)}
      (! return {result}) ]
end
