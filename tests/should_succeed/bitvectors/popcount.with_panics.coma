      | s23 = {[@expl:Add overflow] not _25.f1} s24
      | s24 = [ &x <- UInt32BW.bw_and _25.f0 (252645135: UInt32BW.t) ] s25
      | s25 = [ &_29 <- (8: Int32BW.t) ] s26
      | s26 = [ &_30 <- UInt32BW.lt _29 (32: UInt32BW.t) ] s27
      | s27 = {[@expl:Shr overflow] _30} s28
      | s28 = UInt32BW.shr {x} {Int32BW.to_BV256 (8: Int32BW.t)} (fun (_x: UInt32BW.t) -> [ &_27 <- _x ] s29)
      | s29 = [ &_31 <- let (_fst, _snd) = UInt32BW.add_with_overflow x _27 in { f0 = _fst; f1 = _snd } ] s30
